# --- Local Models (Ollama, LM Studio, vLLM) ---
# 1. Run Ollama: ollama run qwen2.5-coder:7b
# 2. Set LLM_PROVIDER=local or ollama
# LLM_PROVIDER=local
# LOCAL_MODEL=qwen2.5-coder:7b
# LOCAL_BASE_URL=http://localhost:11434/v1

# --- Cloud Providers ---
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud (Free high-speed alternative): https://console.groq.com/keys
GROQ_CLOUD_API_KEY=your-groq-key-here
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Force provider ('local', 'ollama', 'gemini', 'groq')
# LLM_PROVIDER=groq
